{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Biblioteca de Prompts",
    "version":  "0.1.0",
    "identifier":  "com.biblioteca.prompts",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Biblioteca de Prompts",
                                    "width":  1280,
                                    "height":  800
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; img-src \u0027self\u0027 asset: http://asset.localhost blob: data:; media-src \u0027self\u0027 asset: http://asset.localhost blob:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; connect-src \u0027self\u0027 ipc: http://ipc.localhost",
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [
                                                                     "$APPDATA/media/**"
                                                                 ]
                                                   }
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               }
}
